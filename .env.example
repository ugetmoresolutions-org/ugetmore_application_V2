# Business backend API base URL (falls back to http://localhost:5000 if unset)
NEXT_PUBLIC_URL=

# Amrod vendor API credentials (server-only — never prefix with NEXT_PUBLIC_)
AMROD_USERNAME=
AMROD_PASSWORD=
AMROD_CUSTOMER_CODE=

# Parrot customer product feed token (server-only)
PARROT_FEED_TOKEN=

# Tarsus data feed API key (server-only)
TARSUS_API_KEY=
